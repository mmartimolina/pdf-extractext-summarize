# Microservicio pdf-summarize: variables de configuración.
# Copiar a .env y completar los secretos. NUNCA subir .env a Git.

# --- Proveedor de IA (API compatible con OpenAI) ---
# Obligatoria para generar resúmenes reales. Sin ella, POST /summarize
# responde 503 con código LLM_NOT_CONFIGURED.
LLM_API_KEY=tu_api_key_aqui
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1000

# --- Microservicios del ecosistema ---
# Valores por defecto para la red Docker compartida. En local, apuntar a
# las URLs reales de cada servicio.
VALIDATION_SERVICE_URL=http://pdf-validation:8000
EXTRACT_SERVICE_URL=http://extract:8000
PERSISTENCE_SERVICE_URL=http://pdf-persistence:8003
UPSTREAM_TIMEOUT_SECONDS=30

# --- Servicio ---
MAX_PDF_SIZE_MIB=20
LOG_LEVEL=INFO
PORT=8000

# --- Red Docker del ecosistema (solo docker-compose.ecosystem.yml) ---
PDF_ECOSYSTEM_NETWORK=pdf-ecosystem-net
